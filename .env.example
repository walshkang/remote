# Denon AVR-X1200W IP & Ports
# Local LAN default: 192.168.1.226 (telnet 23, http 80)
# Router port-forwarded example: 71.190.248.179 with DENON_TELNET_PORT=2323 and DENON_HTTP_PORT=8023
DENON_HOST=192.168.1.226
DENON_TELNET_PORT=23
DENON_HTTP_PORT=80

# Philips Hue Bridge IP (app key is saved to data/hue.json after pairing; gitignored)
# Local LAN default: 192.168.1.154
# Router port-forwarded example: 71.190.248.179:8443
HUE_HOST=192.168.1.154

# Litter-Robot 4: your Whisker app login (this file is gitignored - never commit it)
LITTER_ROBOT_EMAIL=
LITTER_ROBOT_PASSWORD=

# BuildingLink Resident API (token is saved to data/buildinglink.json; gitignored)
BUILDINGLINK_ACCESS_TOKEN=

# Active modules
REMOTE_MODULES=denon,hue,litter_robot,buildinglink,demo

# Public domain & security for Caddy TLS (HTTPS)
DOMAIN=remote.walshkang.com
HOME_IP=71.190.248.179

